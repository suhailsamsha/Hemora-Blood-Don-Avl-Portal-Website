# Server port (AI Studio requires 3000)
DEFAULT_APP_PORT=3000

# Path to SQLite database file
DATABASE_PATH=./data/mangaluru_blood_portal.db

# HMAC / JWT secret for hashing donor phone numbers, encrypting private contact numbers, and signing admin JWTs
# Change this to a long random string in production
OTP_HMAC_SECRET=change-this-to-a-random-64-char-hex-secret

# Default seeded admin account credentials for /admin/login
ADMIN_EMAIL=admin@bloodportal.org
ADMIN_PASSWORD=change-this-admin-password
ADMIN_NAME=Mangaluru Portal Coordinator

# Set to "true" to suppress OTP test hint in API responses when using a real SMS gateway
HIDE_DEV_OTP_HINT=false

# Public application URL for QR posters and links
APP_URL=http://localhost:3000

# Cloud SQL PostgreSQL connection (provided at runtime via SQL_* environment variables)
SQL_HOST=
SQL_DB_NAME=
SQL_USER=
SQL_PASSWORD=
SQL_ADMIN_USER=
SQL_ADMIN_PASSWORD=

# Google Maps Platform browser API key
VITE_GOOGLE_MAPS_API_KEY=

